{
  "manifest_version": 3,
  "name": "Quickspeak",
  "description": "Record speech locally or communicate with an LLM using a session-only API key.",
  "version": "0.2.0",
  "minimum_chrome_version": "113",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Quickspeak"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
  }
}
